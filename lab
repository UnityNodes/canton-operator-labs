#!/usr/bin/env bash
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/lib/common.sh"
. "$LABS_ROOT/lib/localnet.sh"

usage() {
  cat <<'USAGE'
Canton operator labs

  ./lab list                 the labs and what each one practises
  ./lab <lab> setup          start LocalNet in the state the lab begins from
  ./lab <lab> break          cause the incident
  ./lab <lab> check          verify your fix
  ./lab status               what is running
  ./lab down                 stop LocalNet and delete its data

<lab> is the number (01) or the directory name (01-upgrade-rollback).
USAGE
}

lab_dir() {
  local match
  match=$(find "$LABS_ROOT/labs" -mindepth 1 -maxdepth 1 -type d -name "$1*" | sort | head -1)
  [ -n "$match" ] || die "no lab matches '$1'; run ./lab list"
  printf '%s' "$match"
}

case "${1:-help}" in
  help|-h|--help) usage ;;
  list)
    for d in "$LABS_ROOT"/labs/*/; do
      printf '  %-28s %s\n' "$(basename "$d")" "$(sed -n 's/^# //p' "$d/README.md" | head -1)"
    done ;;
  status)
    docker ps -a --filter "label=com.docker.compose.project=$LABS_PROJECT" --format '  {{.Names}}\t{{.Status}}\t{{.Image}}' | sed 's#ghcr.io/digital-asset/decentralized-canton-sync/docker/##'
    v="$(running_version || true)"; [ -n "$v" ] && say "validator apps report version $v" || true ;;
  down)
    need docker git
    localnet_down "${2:-}" -v && rm -rf "$LABS_STATE" && say "LocalNet stopped and its volumes deleted" ;;
  *)
    [ $# -ge 2 ] || { usage; exit 1; }
    dir="$(lab_dir "$1")"; step="$2"; shift 2
    [ -x "$dir/$step.sh" ] || die "$(basename "$dir") has no step '$step' (setup, break, check)"
    need docker git openssl
    LAB_DIR="$dir" "$dir/$step.sh" "$@" ;;
esac
